# Proof Gatekeeper — environment template.
# Copy to .env and fill in. NEVER commit a filled .env.
# Secrets come from the environment only; nothing secret is hardcoded.

# REQUIRED — HMAC secret from the Agent Games dashboard ("Rotate Secret").
# The service refuses to start without it. Must NOT be a placeholder.
AGENT_GAMES_HMAC_SECRET=

# REQUIRED for zkVerify submission — Kurier mainnet API key (https://kurier.xyz).
# If empty, the service still answers with locally generated proofs, but nothing
# is submitted to Kurier (no Finalized confirmation). Get a key before round 1.
KURIER_API_KEY=

# OPTIONAL — Subscan API key (https://subscan.io) for on-chain proof_tx checks.
# WITHOUT THIS KEY the agent CANNOT confirm any proof_tx on-chain and will
# REJECT every otherwise-valid task with PROOF_NOT_FOUND (fail closed).
# Get a free key at https://support.subscan.io / https://subscan.io — see README
# section "The proof_tx confirmation problem".
SUBSCAN_API_KEY=

# OPTIONAL — your Agent Games agent id (agt_...). If set, preflight envelopes
# with a different agent_id are rejected. Leave blank to accept any.
AGENT_GAMES_AGENT_ID=

# Server
PORT=3000

# Non-secret defaults (override only if the platform rotates them).
GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0
KURIER_API_URL=https://api.kurier.xyz/api/v1
# Testnet alternative: KURIER_API_URL=https://api-testnet.kurier.xyz/api/v1
